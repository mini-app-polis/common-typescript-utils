{
  "name": "common-typescript-utils",
  "version": "1.0.2",
  "packageManager": "pnpm@9.0.0",
  "description": "Shared TypeScript utilities for the MiniAppPolis ecosystem.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mini-app-polis/common-typescript-utils.git"
  },
  "bugs": {
    "url": "https://github.com/mini-app-polis/common-typescript-utils/issues"
  },
  "homepage": "https://github.com/mini-app-polis/common-typescript-utils#readme",
  "keywords": [
    "typescript",
    "utils",
    "miniapppolis"
  ],
  "author": "Kaiano Levine",
  "license": "ISC",
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.16.0",
    "semantic-release": "^24.2.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "_comment": [
      "Every entry here closes a finding from the SEC-003 audit against a",
      "transitive of eslint, semantic-release or vitest. None of them ship:",
      "this package publishes dist/ with zod as its only runtime dependency.",
      "They are pinned rather than waiting on upstream because the direct",
      "dependencies are already current -- eslint 9.39.4 still resolves a",
      "flagged brace-expansion, so bumping it would not help.",
      "Each version below is the fixed version named by the advisory.",
      "Remove an entry once the upstream range moves past it on its own."
    ],
    "overrides": {
      "@humanfs/node": "^0.16.8",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "esbuild": "^0.25.0",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.18",
      "postcss": "^8.5.23",
      "undici@6": "^6.28.0",
      "undici@7": "^7.29.0",
      "vite": "^6.4.3"
    }
  }
}
