{
  "compilerOptions": {
    // @types/node is required by src/logger.ts (process.env) and must be
    // declared. TypeScript 6 no longer auto-includes node_modules/@types,
    // so without this the build config -- which excludes the test files that
    // were transitively pulling in node types via vitest -- loses `process`.
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
